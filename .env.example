# Public values only. Never put relayer keys, sponsor tokens, or KMS credentials here.
# These are baked into the frontend at build time (Vite VITE_* prefix).

# Starknet Sepolia JSON-RPC (read-only is enough for most sections).
VITE_RPC_URL=https://starknet-sepolia-rpc.publicnode.com

# Optional live Kamui services. Leave empty to use the in-app demo keychain
# and keep login / sponsored-call sections in explainer mode.
# VITE_KEYCHAIN_URL=https://sepolia.kamui.page
# VITE_API_URL=https://api-sepolia.kamui.page
# Pepper service is deployed; this demo defaults to it. Set empty to skip the call.
# VITE_PEPPER_URL=https://pepper-sepolia.kamui.page
# Public Google Web client ID. A default is baked in; override here if needed.
# VITE_GOOGLE_CLIENT_ID=612906135098-gclndmmib7jnn6hhj5p55akei3kjtbdv.apps.googleusercontent.com
# VITE_SPONSOR_URL=
# VITE_CLASS_HASH=0x1e128dae2cb709cac9263afa1c6fdb33f7f1f5c2d969547d9739326d08399f6
# VITE_TARGET=0x2f8ce9fcc5f6e165ab5dcccf865c4c08e7d752d6b930938195683eef9f43dfc
# VITE_REGISTRY_ADDRESS=0x4bc2b2afcce053e788511a851e6aeb004d18adb243df4fe852e1b727bd09808
